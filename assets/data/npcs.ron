// Menu-option dialogue (GDD §9). A line may require a skill, attribute or rep
// threshold; write the requirement into the text in brackets, the way the GDD does.
// An unmet line still shows, greyed, so the player learns what they are short of.
{
    "grisha": Npc(
        name: "Grisha",
        start: "hello",
        nodes: {
            "hello": Node(
                text: "You walked here. Everyone who walks here wants something, and most of them want it to be something else. Sit. The drink is the only honest thing in here.",
                options: [
                    Line(text: "What is the talk?", goto: Some("rumour")),
                    Line(
                        text: "[Barter 45] Your prices are an insult.",
                        req: Some(Skill(Barter, 45)),
                        goto: Some("haggle"),
                    ),
                    Line(
                        text: "[Loners 25] You know me. Anything you are holding back?",
                        req: Some(Rep("loners", 25)),
                        goto: Some("trusted"),
                    ),
                    Line(text: "Nothing. I am just passing.", goto: None),
                ],
            ),
            "rumour": Node(
                text: "A Flesh has taken the quarry rim. Somebody should do something, and by that I mean somebody else. It will still be there next week. It is always still there next week.",
                options: [
                    Line(text: "Somebody should.", goto: Some("hello")),
                    Line(text: "I will keep it in mind.", action: Some(SetFlag("heard_the_rumour")), goto: None),
                ],
            ),
            "haggle": Node(
                text: "Fine. For you, cost. Do not tell the others what you paid, and do not tell yourself you got a bargain, because nobody gets a bargain in here.",
                options: [
                    Line(text: "Let me see the shelf.", action: Some(Trade("barkeep")), goto: None),
                    Line(text: "Later.", goto: Some("hello")),
                ],
            ),
            "trusted": Node(
                text: "There is a hatch under the camp. You did not hear it from me, and if it is still there when you go looking, take that as a kindness and not a promise.",
                options: [Line(text: "I did not.", goto: Some("hello"))],
            ),
        },
    ),
    "osip": Npc(
        name: "Quartermaster Osip",
        start: "hello",
        nodes: {
            "hello": Node(
                text: "Duty holds this road. That is all we hold any more. State your business, stalker, and keep it short.",
                options: [
                    Line(text: "I want to buy.", action: Some(Trade("gunrunner")), goto: None),
                    Line(text: "What is Duty doing out here?", goto: Some("creed")),
                    Line(
                        text: "[Duty 25] Anything you cannot requisition through channels?",
                        req: Some(Rep("duty", 25)),
                        goto: Some("favour"),
                    ),
                    Line(text: "Nothing.", goto: None),
                ],
            ),
            "creed": Node(
                text: "The Zone stays in the Zone. That is the whole of it, and it has been the whole of it for ten years, and it is still leaking.",
                options: [Line(text: "And the artifacts?", goto: Some("artifacts"))],
            ),
            "artifacts": Node(
                text: "Contained. Studied. Not sold to whoever walks in off the road. What we cannot contain, we bury, and what we cannot bury, we pretend is contained.",
                options: [
                    Line(text: "And who decides that?", action: Some(Lore("duty")), goto: Some("hello")),
                    Line(text: "Understood.", goto: Some("hello")),
                ],
            ),
            "favour": Node(
                text: "The board is yours, then. Take something off it before you go. It will still be full when you come back.",
                options: [
                    Line(text: "Show me the board.", action: Some(Jobs("duty")), goto: None),
                    Line(text: "Another time.", goto: Some("hello")),
                ],
            ),
        },
    ),
    "sidorovich": Npc(
        name: "Sidorovich",
        start: "hello",
        nodes: {
            "hello": Node(
                text: "Still standing. Good. The ones who are not standing spend nothing, and the ones who are spend it all. Which kind are you today?",
                options: [
                    Line(text: "Show me the shelf.", action: Some(Trade("trader"))),
                    Line(text: "What is worth carrying out?", goto: Some("artifacts")),
                    Line(
                        text: "[Barter 55] Your margins are theft.",
                        req: Some(Skill(Barter, 55)),
                        goto: Some("margins"),
                    ),
                    Line(text: "Nothing today.", goto: None),
                ],
            ),
            "artifacts": Node(
                text: "Artifacts. Always artifacts. Everything else you bring me is weight, and weight is what dead men carry out.",
                options: [
                    Line(text: "What are they, though?", action: Some(Lore("artifacts")), goto: Some("hello")),
                    Line(text: "Understood.", goto: Some("hello")),
                ],
            ),
            "margins": Node(
                text: "Theft is when you take it. This is commerce, and commerce has a roof over it and a ledger that never balances. Take it or leave it. The Zone takes everything eventually.",
                options: [Line(text: "Fine.", goto: Some("hello"))],
            ),
        },
    ),
    "yerin": Npc(
        name: "Doctor Yerin",
        start: "hello",
        nodes: {
            "hello": Node(
                text: "Sit down before you fall down. I can see the count on you from here, and I have seen it a thousand times, and it always ends the same way.",
                options: [
                    Line(text: "What have you got?", action: Some(Trade("doctor"))),
                    Line(text: "How bad is what I am carrying?", goto: Some("rads")),
                    Line(text: "I am fine.", goto: None),
                ],
            ),
            "rads": Node(
                text: "Every one of them is a loan, and you are not the first man to think he could outrun the interest, and you will not be the last, and I will still be here counting the same numbers.",
                options: [
                    Line(text: "Go on.", action: Some(Lore("the_price")), goto: Some("hello")),
                    Line(text: "I will manage.", goto: Some("hello")),
                ],
            ),
        },
    ),
    "kolya": Npc(
        name: "Kolya",
        start: "hello",
        nodes: {
            "hello": Node(
                text: "Duty told you we were animals down here, and here you are anyway. Sit. Have something. It does not make either of us any less dead, but it is warm.",
                options: [
                    Line(text: "What does Freedom actually want?", goto: Some("creed")),
                    Line(text: "Anything on the board?", action: Some(Jobs("freedom"))),
                    Line(
                        text: "[Freedom 25] They say you go further in than anyone.",
                        req: Some(Rep("freedom", 25)),
                        goto: Some("deep"),
                    ),
                    Line(text: "Passing through.", goto: None),
                ],
            ),
            "creed": Node(
                text: "The Zone belongs to whoever walks it. That is the whole of it, whatever the black-and-reds tell you. Nobody owns the Zone. It owns us, and it is very patient.",
                options: [
                    Line(text: "And after that?", action: Some(Lore("freedom")), goto: Some("hello")),
                    Line(text: "Simple enough.", goto: Some("hello")),
                ],
            ),
            "deep": Node(
                text: "Further than is sensible, and not by my choosing. The rifts do not warn you. Nothing warns you. One day you are walking, the next you are somewhere else, and the somewhere else does not know your name.",
                options: [
                    Line(text: "How do you read one?", action: Some(Lore("rifts")), goto: Some("hello")),
                ],
            ),
        },
    ),
    "kuzma": Npc(
        name: "Kuzma",
        start: "hello",
        nodes: {
            "hello": Node(
                text: "Look at this. A stalker walked in on his own legs, carrying things, and did not knock. That is either courage or a death wish, and in here they come to the same place.",
                options: [
                    Line(
                        text: "[Bandits 25] I am not a stranger here.",
                        req: Some(Rep("bandits", 25)),
                        goto: Some("known"),
                    ),
                    Line(
                        text: "[Barter 60] There is a version of this where we both profit.",
                        req: Some(Skill(Barter, 60)),
                        goto: Some("deal"),
                    ),
                    Line(text: "What is this place?", goto: Some("junkyard")),
                    Line(text: "Leave, slowly.", goto: None),
                ],
            ),
            "junkyard": Node(
                text: "This is where things end up. Cars, kit, men. Mostly it sorts itself, which is to say the Zone sorts it, and the Zone does not ask what anything was for.",
                options: [
                    Line(text: "Charming.", action: Some(Lore("bandits")), goto: Some("hello")),
                ],
            ),
            "known": Node(
                text: "So you are. Keep your hands where they are, and we will keep being friendly, which in here means we will rob you slowly instead of all at once.",
                options: [Line(text: "Understood.", goto: Some("hello"))],
            ),
            "deal": Node(
                text: "There he is. Talk like that and a man forgets he was going to rob you, which is the only kind of forgetting this place allows.",
                options: [Line(text: "Let us keep it that way.", goto: Some("hello"))],
            ),
        },
    ),
    "professor": Npc(
        name: "Professor Ilyin",
        start: "hello",
        nodes: {
            "hello": Node(
                text: "You are not scheduled. Nothing out here is scheduled, and nothing out here ever goes home on time. Come in before something follows you.",
                options: [
                    Line(text: "What is the Lab measuring?", goto: Some("measuring")),
                    Line(text: "Anything you need fetched?", action: Some(Jobs("ecologists"))),
                    Line(
                        text: "[Science 45] Your graphs do not close, do they.",
                        req: Some(Skill(Science, 45)),
                        goto: Some("graphs"),
                    ),
                    Line(text: "Another time.", goto: None),
                ],
            ),
            "measuring": Node(
                text: "Everything. For ten years. The instruments are excellent and the conclusions are embarrassing, which is a polite way of saying we have learned only that it cannot be learned.",
                options: [
                    Line(text: "Embarrassing how?", action: Some(Lore("ecologists")), goto: Some("hello")),
                ],
            ),
            "graphs": Node(
                text: "No. They do not. I would rather you had not been able to see that. A man can live with not understanding, but not with being shown it in red ink every morning.",
                options: [
                    Line(text: "What is an artifact, really?", action: Some(Lore("artifacts")), goto: Some("hello")),
                    Line(text: "I will keep it to myself.", goto: Some("hello")),
                ],
            ),
        },
    ),
    "hermit": Npc(
        name: "The Hermit",
        start: "hello",
        nodes: {
            "hello": Node(
                text: "Do not stand in the doorway. Things come down that street, and I would rather they came past than in, and I would rather you came in than made me think about it.",
                options: [
                    Line(
                        text: "[carrying vodka] I brought something.",
                        req: Some(Both(Carrying("vodka"), NotFlag("paid_hermit"))),
                        action: Some(Spend("vodka", 1)),
                        flag: Some("paid_hermit"),
                        goto: Some("paid"),
                    ),
                    Line(text: "They say you have been to the centre.", goto: Some("centre")),
                    Line(text: "Is anyone paying for anything?", action: Some(Jobs("mercs"))),
                    Line(text: "What happened here?", goto: Some("town")),
                    Line(text: "Nothing. Sorry.", goto: None),
                ],
            ),
            "centre": Node(
                text: "I have been close. Close is a different country from there, and I came back, which tells you what I am. The ones who go all the way do not come back, and the ones who do come back are not the ones who went.",
                options: [
                    Line(text: "What is at the centre?", action: Some(Lore("the_room")), goto: Some("hello")),
                    Line(text: "You came back, though.", action: Some(Lore("the_walk_out")), goto: Some("hello")),
                ],
            ),
            "town": Node(
                text: "It emptied. Not all at once, which was the bad part. People kept deciding to stay one more week, and then one more, and then the deciding stopped and there was no one left to ask.",
                options: [
                    Line(text: "And the first day?", action: Some(Lore("the_first_day")), goto: Some("hello")),
                ],
            ),
            "paid": Node(
                text: "Then sit. The road in runs under the antenna, and the antenna is the only thing out here that knows it, and it will tell you if you are willing to listen to a thing that has never once been wrong and never once been kind.",
                options: [
                    Line(text: "Tell me about the antenna.", action: Some(Lore("the_radar")), goto: Some("hello")),
                    Line(text: "That is what I needed.", goto: Some("hello")),
                ],
            ),
        },
    ),
    "voice": Npc(
        name: "A Voice Under the Antenna",
        start: "hello",
        nodes: {
            "hello": Node(
                text: "It is not speaking to you. It has been speaking since before you got here, and it will go on after you are gone, and some of it happens to be in words, and the words are not for you.",
                options: [
                    Line(text: "Listen properly.", goto: Some("listen")),
                    Line(
                        text: "[Monolith 25] I have heard this before.",
                        req: Some(Rep("monolith", 25)),
                        goto: Some("known"),
                    ),
                    Line(text: "Put your hands over your ears and go.", goto: None),
                ],
            ),
            "listen": Node(
                text: "Under the hiss there is a shape, and the shape is a direction, and the direction is inward, and everything you have ever wanted is in that direction, which is how it keeps you.",
                options: [
                    Line(text: "Who ends up following it?", action: Some(Lore("monolith")), goto: Some("hello")),
                    Line(text: "That is enough of that.", goto: Some("hello")),
                ],
            ),
            "known": Node(
                text: "Then you know it is not asking. It never asks. It only keeps saying the same thing until it is yours, and then it says nothing at all, and that is worse.",
                options: [Line(text: "Step back.", goto: Some("hello"))],
            ),
        },
    ),
    // The Room (GDD 9). It is an NPC because a wish is a dialogue line: the short
    // list is built from the run by the same requirements every other line uses.
    "room": Npc(
        name: "The Room",
        start: "light",
        nodes: {
            "light": Node(
                text: "The light does not flicker and it does not warm you. It has been waiting the way a room waits, which is not at all, and it is not impatient, because it knows you will ask, and it knows what you will ask, and it has known since before you were born. Ask.",
                options: [
                    Line(
                        text: "[Monolith 50] I am listening. I have been listening a long time.",
                        req: Some(Rep("monolith", 50)),
                        action: Some(End("monolith")),
                    ),
                    Line(
                        text: "[2000 RU] Make it so I never have to come back in here for money.",
                        req: Some(Rubles(2000)),
                        action: Some(End("riches")),
                    ),
                    Line(
                        text: "[killed a Flesh] Make me the thing the rim runs from.",
                        req: Some(Killed("flesh")),
                        action: Some(End("power")),
                    ),
                    Line(
                        text: "[2 jobs done] Make them remember my name out there.",
                        req: Some(QuestsDone(2)),
                        action: Some(End("remembered")),
                    ),
                    Line(text: "Make me whole. That is all.", action: Some(End("health"))),
                    Line(text: "Say nothing. Turn around.", action: Some(End("refuse"))),
                ],
            ),
        },
    ),
}
