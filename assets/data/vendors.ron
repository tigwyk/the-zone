// GDD 7: each vendor's markup is its specialty. A doctor only stocks meds, so a
// flat 1.2 is "1.2 on meds"; the barkeep's 0.8 is "cheap food".
{
    "trader": Vendor(
        name: "Sidorovich",
        faction: "loners",
        markup: 1.0,
        artifact_markup: 1.5,
        stock: [
            ("medkit", 3), ("bandage", 6), ("antirad", 2), ("bread", 4),
            ("bolt", 20), ("knife", 1), ("flashlight", 1), ("headlamp", 1),
            ("pistol", 1), ("jacket", 1), ("vest", 1), ("lockpicks", 1),
            ("detector", 1), ("toolkit", 1),
            // The cheap end of the ammunition (GUNS §2); Osip stocks the rest.
            ("pistol_surplus", 60), ("pistol_round", 40), ("shell_birdshot", 40),
        ],
    ),
    "barkeep": Vendor(
        name: "Grisha",
        faction: "loners",
        markup: 0.8,
        stock: [
            ("vodka", 8), ("bread", 6), ("tinned_meat", 6), ("sausage", 4),
            ("tea", 6), ("energy_bar", 4),
        ],
    ),
    "doctor": Vendor(
        name: "Doctor Yerin",
        faction: "loners",
        markup: 1.2,
        stock: [
            ("medkit", 5), ("bandage", 10), ("antirad", 5), ("army_medkit", 2),
            ("tourniquet", 4), ("stimulant", 2), ("radioprotectant", 2), ("antidote", 3),
        ],
    ),
    "gunrunner": Vendor(
        name: "Quartermaster Osip",
        faction: "duty",
        markup: 1.2,
        stock: [
            ("pistol", 2), ("revolver", 1), ("sawn_off", 2), ("shotgun", 1),
            ("rifle", 1), ("sniper", 1), ("machete", 1), ("axe", 1),
            ("vest", 2), ("duty_armour", 1), ("trench_coat", 2),
            ("pistol_round", 60), ("pistol_ap", 30), ("shell_buck", 40), ("shell_slug", 20),
            ("rifle_surplus", 60), ("rifle_round", 60), ("rifle_ap", 30),
            ("grip", 2), ("laser", 1), ("scope", 1), ("bayonet", 2),
            ("trigger", 1), ("mag_well", 2), ("muzzle", 1), ("plate", 1), ("liner", 1),
        ],
    ),
}
