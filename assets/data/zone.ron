// The world: where you can stand and what you can do there. Items, vendors,
// enemies, NPCs, quests and factions live in their own files (SPEC §5.3).
Zone(
    start: "camp",
    areas: {
        "camp": Area(
            name: "Base Camp",
            art: "camp",
            shelter: true,
            menu: [
                ("Travel", Travel("road")),
                ("Trade", Trade("trader")),
                ("The bar", Travel("bar")),
                ("Rest", Rest),
                ("The memorial", Memorial),
            ],
            secrets: {
                'D': Secret(action: Travel("hatch")),
            },
        ),
        "bar": Area(
            name: "The Bar",
            art: "bar",
            shelter: true,
            menu: [
                ("Talk to Grisha", Talk("grisha")),
                ("Buy a drink", Trade("barkeep")),
                ("See the doctor", Trade("doctor")),
                ("Job board", Jobs("loners")),
                ("Outside", Travel("camp")),
            ],
            secrets: {
                'K': Secret(action: Say("The keg is empty. Someone has been at it from behind."),
                            gate: Some(Check(StalkerLore, -20))),
            },
        ),
        "hatch": Area(
            name: "The Hatch",
            art: "hatch",
            shelter: true,
            menu: [
                ("Read the log", SetFlag("read_the_log")),
                ("Search", Say("Dust, a dead man's kit, and nothing worth carrying.")),
                ("Return", Travel("camp")),
            ],
            secrets: {},
        ),
        "road": Area(
            name: "The Road",
            art: "road",
            shelter: false,
            menu: [
                ("Travel", Travel("camp")),
                ("Cut toward the field", Travel("field")),
                ("North, to the checkpoint", Travel("duty_post")),
                ("Look", Say("The road runs east, toward the wastes.")),
                ("Search", Say("You find a spent cartridge.")),
            ],
            secrets: {},
        ),
        "duty_post": Area(
            name: "Checkpoint 4",
            art: "duty_post",
            shelter: true,
            menu: [
                ("Talk to Osip", Talk("osip")),
                ("Quartermaster", Trade("gunrunner")),
                ("Job board", Jobs("duty")),
                ("Look", Say("Black and red patches. Nobody is smiling.")),
                ("South, to the road", Travel("road")),
            ],
            secrets: {},
        ),
        "room": Area(
            name: "The Room",
            art: "room",
            shelter: true,
            menu: [
                ("Step into the light", Talk("room")),
                ("Turn back up the tunnel", Travel("quarry")),
            ],
            secrets: {},
        ),
        "field": Area(
            name: "The Whirligig Field",
            art: "field",
            shelter: false,
            anomaly: Some(Anomaly(
                name: "Whirligig",
                danger: 55,
                dice: (6, 6),
                artifact: "gravi",
                beyond: "quarry",
            )),
            menu: [
                ("Scan", Scan),
                ("Throw Bolt", ThrowBolt),
                ("Push Through", PushThrough),
                ("Take Artifact", TakeArtifact),
                ("Leave", Travel("road")),
            ],
            secrets: {
                'G': Secret(action: TakeArtifact, gate: Some(Check(StalkerLore, -10))),
            },
        ),
        "quarry": Area(
            name: "The Quarry Rim",
            art: "quarry",
            shelter: false,
            encounter: Some("flesh"),
            menu: [
                ("Look", Say("Black water, and the pumps long dead.")),
                ("Search", Say("Rust, and rust under the rust.")),
                ("Take the service track", Travel("road")),
                ("Back through the field", Travel("field")),
            ],
            secrets: {
                'S': Secret(action: Say("The log was right. The crate holds two medkits and a bolt tin."),
                            gate: Some(Flag("read_the_log"))),
                // GDD 9: the route to the centre opens for whoever stands highest
                // with somebody. It does not care which somebody.
                'T': Secret(action: Travel("room"), gate: Some(AnyRep(50))),
            },
        ),
    },
)
